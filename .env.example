# OpenAI — enables claim extraction, verification, evidence judge, embeddings, Whisper, vision
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1

# Admin review queue (Authorization: Bearer <token>)
ADMIN_TOKEN=dev-admin-token

# Database (docker-compose sets this automatically)
DATABASE_URL=postgresql+asyncpg://sachkhoj:sachkhoj@localhost:5432/sachkhoj

# Local SQLite fallback when Postgres is unavailable
# DATABASE_URL=sqlite+aiosqlite:///./sachkhoj.db

# Social media downloads — Netscape cookies file for Instagram/Facebook/YouTube reliability
# SOCIAL_COOKIES_FILE=/path/to/cookies.txt

# Optional overrides
# CURATED_DATA_DIR=../data/curated
# UPLOAD_DIR=./uploads
# CONFIDENCE_REVIEW_THRESHOLD=0.7
# MAX_VIDEO_SECONDS=900
# VIDEO_FRAMES_TO_SAMPLE=6
